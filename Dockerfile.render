# Optimized Dockerfile for Render.com deployment
# Multi-stage build to minimize final image size

FROM ubuntu:22.04 AS builder

# Install minimal build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    libboost-filesystem-dev \
    libboost-system-dev \
    libboost-thread-dev \
    libcurl4-openssl-dev \
    libpq-dev \
    libpqxx-dev \
    libssl-dev \
    nlohmann-json3-dev \
    pkg-config \
    postgresql-server-dev-all \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && rm -rf /tmp/* /var/tmp/*

WORKDIR /app

# Copy build directory (may be empty if not present)
COPY build ./build

# Copy source files for building
COPY CMakeLists.txt .
COPY src/ src/
COPY include/ include/
COPY config/ config/
COPY tests/ tests/
COPY demos/ demos/

# Check if executable exists and is compatible, if not build it
RUN if [ -f "./build/bin/ETLPlusBackend" ] && ./build/bin/ETLPlusBackend --version >/dev/null 2>&1; then \
        echo "Using compatible pre-built executable from build folder"; \
        mkdir -p bin && cp ./build/bin/ETLPlusBackend ./bin/; \
    else \
        echo "Building executable from source (pre-built not compatible or missing)"; \
        # Build with size optimization \
        cmake -B build \
            -DCMAKE_BUILD_TYPE=MinSizeRel \
            -DCMAKE_CXX_FLAGS="-Os -s -DNDEBUG" \
            -DCMAKE_EXE_LINKER_FLAGS="-s" \
            -DENABLE_TESTS=OFF \
        && cmake --build build --parallel 2 \
        && mkdir -p bin \
        && cp build/bin/ETLPlusBackend bin/; \
    fi

# Minimal runtime stage
FROM ubuntu:22.04 AS runtime

# Install only essential runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    libboost-filesystem1.74.0 \
    libboost-system1.74.0 \
    libboost-thread1.74.0 \
    libpqxx-6.4 \
    libssl3 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && rm -rf /tmp/* /var/tmp/* \
    && groupadd -r etlplus \
    && useradd -r -g etlplus -d /app etlplus

WORKDIR /app

# Copy minimal files
COPY --from=builder /app/bin/ETLPlusBackend ./
COPY --from=builder /app/config/ ./config/

# Create logs directory
RUN mkdir -p logs && chown -R etlplus:etlplus /app

USER etlplus

# Use PORT environment variable from Render
EXPOSE ${PORT:-8080}

# Minimal health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=2 \
    CMD curl -f http://localhost:${PORT:-8080}/api/health || exit 1

CMD ["./ETLPlusBackend"]
